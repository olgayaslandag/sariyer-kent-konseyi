# Sarıyer Kent Konseyi — ortam değişkenleri (örnek)
# Kopyalayın: cp .env.example .env.local
# .env* dosyaları .gitignore'dadır; bu dosya (.env.example) istisnadır.

# Veri kaynağı: mock (varsayılan) | http
#   mock — mocks/data/*.json (build'de ağ bağımlılığı yok)
#   http — API_BASE_URL üzerinden headless API (bkz. lib/data/sources/http.js)
DATA_SOURCE=mock

# Headless API kök URL'i — yalnızca DATA_SOURCE=http iken gerekir.
# Boş bırakılabilir (örn. https://api.example.com veya /api).
# Kendi thin mock route'larınızı http kaynağı yapmak için:
#   DATA_SOURCE=http API_BASE_URL=http://localhost:3000/api
# (app/api/haberler vb. route'lar mock verisini döner; döngü olmaz —
#  route'lar lib/data/sources/mock.js kullanır, index.js kullanmaz.)
API_BASE_URL=

# Site kök URL'i — canonical / sitemap / robots / metadata / OG için tek kaynak.
# Build-time'da okunur (SSG): Docker'da --build-arg SITE_URL=... veya
# compose build.args ile verilir; runtime'da değiştirmek için rebuild gerekir.
# Boş/geçersizse lib/data/config.js varsayılanı uygulanır.
SITE_URL=https://sariyerkentkonseyi.org
